<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>jp.yohaku.agent</string>
<key>ProgramArguments</key><array><string>/ABSOLUTE/PATH/TO/node</string><string>--env-file=.env</string><string>scripts/agent.mjs</string></array>
<key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/yohaku-lab</string>
<key>StartInterval</key><integer>60</integer>
<key>StandardOutPath</key><string>/ABSOLUTE/PRIVATE/LOG/agent.log</string>
<key>StandardErrorPath</key><string>/ABSOLUTE/PRIVATE/LOG/agent-error.log</string>
</dict></plist>
